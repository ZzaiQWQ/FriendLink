{
  "schemaVersion": 1,
  "id": "friendlink",
  "version": "${version}",
  "name": "FriendLink",
  "description": "Friend-based official P2P multiplayer backport for Minecraft ${minecraft_supported_version}.",
  "icon": "assets/friendlink/icon.png",
  "authors": [
    "ZzaiQWQ"
  ],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "zz.friendlink.FriendLinkClient"
    ]
  },
  "mixins": [
    "friendlink.mixins.json"
  ],
  "accessWidener": "friendlink.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dependency}",
    "fabric-api": "*"
  }
}
